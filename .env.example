# Copy to .env for `vercel dev`, or set these in Vercel → Settings → Environment
# Variables for a deployment. See SELF-HOSTING.md for where each one comes from.

# Encrypts the session cookies that hold your provider tokens. Changing this
# invalidates every stored token — it is the kill switch.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Your deployment's own URL, e.g. https://atlas-yourname.vercel.app
# Pins the OAuth redirect so it can't be steered by a forged Host header.
APP_URL=

# Google Cloud Console → Credentials → OAuth client ID (Web application)
# Redirect URI: https://YOUR-DOMAIN/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# developer.todoist.com/appconsole.html
# Redirect URI: https://YOUR-DOMAIN/api/auth/callback
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# strava.com/settings/api — callback domain is the bare host, no scheme or path
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional. Powers real conversation: without this, Atlas falls back to its
# original fixed-phrase command matcher (still fully functional, just literal).
# console.anthropic.com → API Keys → Create Key.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-haiku-4-5-20251001 (fast, cheap). Set to
# claude-sonnet-5 for noticeably better reasoning at higher cost/latency.
ANTHROPIC_MODEL=
